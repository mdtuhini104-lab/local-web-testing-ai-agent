# Server Configuration
HOST=127.0.0.1
PORT=8000
DEBUG=True

# Ollama Local AI Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2-vl
# Alternative vision models: llava, llama3.2-vision, bakllava

# Browser & Test Settings
HEADLESS=False
PLAYWRIGHT_TIMEOUT=30000
IGNORE_HTTPS_ERRORS=True
VIEWPORT_WIDTH=1280
VIEWPORT_HEIGHT=800

# Storage Settings
STORAGE_DIR=./storage
DB_PATH=./storage/test_runs.db
